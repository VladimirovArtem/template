# Settings used by labs 1 and 2.
# make run loads existing environment > .env > this file.
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s

# Required: use DATABASE_URL from the .env prepared by tripgoctl.
# No address or credentials are supplied here.
DATABASE_URL=
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_QUERY_TIMEOUT=3s

OTEL_SERVICE_NAME=trip-service
# Set the endpoint supplied by tripgoctl; no collector address is hardcoded.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=service.namespace=tripgo,deployment.environment=local
OTEL_TRACES_SAMPLER=parentbased_always_on
